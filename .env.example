# mock works offline. anthropic uses ANTHROPIC_API_KEY in the worker environment.
# codex uses a separately installed CLI and its login; see README for local use.
REVIEW_MODEL_MODE=mock
# mock/anthropic/codex force one provider for all regions, ignoring saved choices.
# Set REVIEW_MODEL_MODE=regional to enable the site picker (default: Mock).
# In regional mode, enable extra providers after their server-side setup.
# REVIEW_ENABLED_MODELS=codex,anthropic
REVIEW_MEMORY_MATCHING=hybrid
REVIEW_FEED_INTERVAL_SECONDS=30
REVIEW_MODEL_TIMEOUT_SECONDS=90
REVIEW_MODEL_MAX_TOKENS=1200
REVIEW_ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# REVIEW_CODEX_MODEL=
# Fixed claim duration in seconds (15 minutes).
REVIEW_CLAIM_SECONDS=900
# Local HTTP default. Set true when serving through HTTPS.
REVIEW_COOKIE_SECURE=false
# Set a persistent session secret through your environment if sign-ins should
# survive API restarts. The default is generated in memory at process start.
# REVIEW_SESSION_SECRET=
# On a shared host, protect the preview before enabling real accounts.
# SHA-256 verifier of a random access code; never commit the code itself.
# REVIEW_PREVIEW_ACCESS_HASH=

